{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Rank of five breeds by search share, by year",
  "data": {
    "url": "data/trends_bump.csv"
  },
  "width": "container",
  "height": 240,
  "transform": [
    {
      "filter": "datum.country === 'Malaysia'"
    },
    {
      "calculate": "'20' + slice(datum.window, 5, 7)",
      "as": "yr"
    },
    {
      "calculate": "(datum.breed === 'Ragdoll' || datum.breed === 'Persian')",
      "as": "hl"
    }
  ],
  "encoding": {
    "x": {
      "field": "yr",
      "type": "ordinal",
      "title": "12 months to October",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "scale": {
        "reverse": true,
        "domain": [
          0.6,
          5.4
        ]
      },
      "title": "Rank (1 = most searched)",
      "axis": {
        "values": [
          1,
          2,
          3,
          4,
          5
        ],
        "grid": false,
        "domain": false,
        "labels": true,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone"
      },
      "encoding": {
        "detail": {
          "field": "breed"
        },
        "color": {
          "condition": [
            {
              "test": "datum.breed === 'Ragdoll'",
              "value": "#2B2622"
            },
            {
              "test": "datum.breed === 'Persian'",
              "value": "#8A8178"
            }
          ],
          "value": "#C9C2B7"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.hl",
            "value": 4
          },
          "value": 1.6
        },
        "strokeDash": {
          "condition": {
            "test": "datum.breed === 'Persian'",
            "value": [
              6,
              4
            ]
          },
          "value": [
            1,
            0
          ]
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 90
      },
      "encoding": {
        "color": {
          "condition": [
            {
              "test": "datum.breed === 'Ragdoll'",
              "value": "#2B2622"
            },
            {
              "test": "datum.breed === 'Persian'",
              "value": "#8A8178"
            }
          ],
          "value": "#C9C2B7"
        },
        "tooltip": [
          {
            "field": "breed",
            "title": "Breed"
          },
          {
            "field": "yr",
            "title": "12 months to Oct"
          },
          {
            "field": "rank",
            "title": "Rank"
          },
          {
            "field": "share",
            "title": "Share (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.yr === '2026'"
        },
        {
          "filter": "datum.hl"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "breed"
        },
        "color": {
          "value": "#2B2622"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.yr === '2026'"
        },
        {
          "filter": "!datum.hl"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": "normal"
      },
      "encoding": {
        "text": {
          "field": "breed"
        },
        "color": {
          "value": "#6B635B"
        }
      }
    },
    {
      "description": "Annotation: the year Ragdoll overtook Persian",
      "transform": [
        {
          "filter": "datum.yr === '2024' && datum.breed === 'Ragdoll'"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -16,
        "fontSize": 12,
        "fontWeight": "bold",
        "stroke": "#FFFFFF",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "text": {
          "value": "2024: Ragdoll passes Persian"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.yr === '2024' && datum.breed === 'Ragdoll'"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -16,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#2B2622"
      },
      "encoding": {
        "text": {
          "value": "2024: Ragdoll passes Persian"
        }
      }
    }
  ]
}