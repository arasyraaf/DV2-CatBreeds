{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Parallel coordinates: the average trait profile of each coat group (thick), over all 67 breeds (thin grey)",
  "data": {
    "url": "data/traits_long.csv",
    "format": {
      "type": "csv",
      "parse": {
        "score": "number",
        "trait_order": "number"
      }
    }
  },
  "width": "container",
  "height": 360,
  "encoding": {
    "x": {
      "field": "trait",
      "type": "nominal",
      "title": null,
      "sort": [
        "Energy",
        "Needs company",
        "Stranger-friendly",
        "Talkative",
        "Intelligence",
        "Grooming needs",
        "Shedding",
        "Health issues"
      ],
      "scale": {
        "padding": 0.2
      },
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "labelFontWeight": 700,
        "labelFontSize": 12,
        "domain": false,
        "ticks": false,
        "grid": true,
        "gridColor": "#BDB6AC",
        "labelExpr": "split(replace(datum.label, '-', '- '), ' ')",
        "labelLineHeight": 14,
        "labelBaseline": "bottom",
        "labelPadding": 18
      }
    },
    "y": {
      "type": "quantitative",
      "title": "Score (1 = low, 5 = high)",
      "scale": {
        "domain": [
          0.6,
          5.4
        ],
        "nice": false
      },
      "axis": {
        "values": [
          1,
          2,
          3,
          4,
          5
        ],
        "grid": false,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "description": "Layer 1: one thin grey line per breed. Scores are whole numbers, so each breed is nudged slightly up or down to stop lines hiding behind each other",
      "transform": [
        {
          "window": [
            {
              "op": "rank",
              "as": "breedRank"
            }
          ],
          "groupby": [
            "trait"
          ],
          "sort": [
            {
              "field": "name"
            }
          ]
        },
        {
          "calculate": "datum.score + ((datum.breedRank % 9) - 4) * 0.05",
          "as": "y"
        }
      ],
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "name"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "y"
        },
        "detail": {
          "field": "name"
        },
        "color": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": "#2B2622"
          },
          "value": "#CFC7BB"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0.35
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Breed"
          },
          {
            "field": "coat",
            "title": "Coat"
          },
          {
            "field": "trait",
            "title": "Trait"
          },
          {
            "field": "score",
            "title": "Score"
          }
        ]
      }
    },
    {
      "description": "Layer 2: one thick line per coat group = its average score on each trait",
      "transform": [
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "score",
              "as": "avg"
            }
          ],
          "groupby": [
            "coat",
            "trait"
          ]
        }
      ],
      "params": [
        {
          "name": "coatPick",
          "select": {
            "type": "point",
            "fields": [
              "coat"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 4,
        "point": {
          "size": 60,
          "filled": true
        }
      },
      "encoding": {
        "y": {
          "field": "avg"
        },
        "color": {
          "field": "coat",
          "type": "nominal",
          "title": "Coat group (click to pick one)",
          "scale": {
            "domain": [
              "Short",
              "Long",
              "Short or long",
              "Rex or hairless"
            ],
            "range": [
              "#9A7B10",
              "#7E3F98",
              "#6E6E6E",
              "#3D2B56"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "stroke",
            "symbolStrokeWidth": 4,
            "titleLimit": 0
          }
        },
        "opacity": {
          "condition": {
            "param": "coatPick",
            "value": 1
          },
          "value": 0.12
        },
        "tooltip": [
          {
            "field": "coat",
            "title": "Coat group"
          },
          {
            "field": "trait",
            "title": "Trait"
          },
          {
            "field": "avg",
            "title": "Average score",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "description": "Layer 3: two labels on the traits where the groups split, placed just above (Long) or below (Rex and hairless) the point so they clear the lines",
      "transform": [
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "score",
              "as": "avg"
            }
          ],
          "groupby": [
            "coat",
            "trait"
          ]
        },
        {
          "filter": "(datum.coat === 'Long' && datum.trait === 'Grooming needs') || (datum.coat === 'Rex or hairless' && datum.trait === 'Shedding')"
        },
        {
          "calculate": "(datum.coat === 'Long' ? 'Long coats ' : 'Rex and hairless ') + format(datum.avg, '.1f')",
          "as": "label"
        },
        {
          "calculate": "datum.avg + (datum.coat === 'Long' ? 0.38 : -0.32)",
          "as": "label_y"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 12,
        "fontWeight": "bold",
        "stroke": "#FFFFFF",
        "strokeWidth": 3,
        "strokeJoin": "round",
        "strokeOpacity": 0.9,
        "dx": 2
      },
      "encoding": {
        "y": {
          "field": "label_y"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "value": "#FFFFFF"
        }
      }
    },
    {
      "description": "Layer 4: the same labels drawn over their white halo",
      "transform": [
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "score",
              "as": "avg"
            }
          ],
          "groupby": [
            "coat",
            "trait"
          ]
        },
        {
          "filter": "(datum.coat === 'Long' && datum.trait === 'Grooming needs') || (datum.coat === 'Rex or hairless' && datum.trait === 'Shedding')"
        },
        {
          "calculate": "(datum.coat === 'Long' ? 'Long coats ' : 'Rex and hairless ') + format(datum.avg, '.1f')",
          "as": "label"
        },
        {
          "calculate": "datum.avg + (datum.coat === 'Long' ? 0.38 : -0.32)",
          "as": "label_y"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 12,
        "fontWeight": "bold",
        "dx": 2
      },
      "encoding": {
        "y": {
          "field": "label_y"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "field": "coat",
          "type": "nominal",
          "scale": {
            "domain": [
              "Short",
              "Long",
              "Short or long",
              "Rex or hairless"
            ],
            "range": [
              "#9A7B10",
              "#7E3F98",
              "#6E6E6E",
              "#3D2B56"
            ]
          },
          "legend": null
        }
      }
    }
  ]
}