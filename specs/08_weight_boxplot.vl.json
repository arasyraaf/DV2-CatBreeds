{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Typical weight by coat group, 67 breeds",
  "data": {
    "url": "data/weight_by_coat.csv"
  },
  "width": "container",
  "height": 320,
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "n"
        }
      ],
      "groupby": [
        "coat"
      ]
    },
    {
      "calculate": "datum.coat + ' (' + datum.n + ')'",
      "as": "group"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rn"
        }
      ],
      "groupby": [
        "coat"
      ],
      "sort": [
        {
          "field": "name"
        }
      ]
    },
    {
      "calculate": "((datum.rn * 7) % 11) / 10",
      "as": "jit"
    }
  ],
  "encoding": {
    "x": {
      "field": "group",
      "type": "nominal",
      "title": null,
      "sort": [
        "Short (32)",
        "Long (19)",
        "Short or long (9)",
        "Rex or hairless (7)"
      ],
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelLimit": 0,
        "labelColor": {
          "expr": "indexof(datum.label, 'Short or long') === 0 ? '#6E6E6E' : indexof(datum.label, 'Short') === 0 ? '#9A7B10' : indexof(datum.label, 'Long') === 0 ? '#7E3F98' : '#3D2B56'"
        },
        "labelFontWeight": 700
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": "min-max",
        "size": 64,
        "median": {
          "color": "#FFFFFF",
          "size": 64,
          "thickness": 3
        },
        "rule": {
          "color": "#6B635B"
        },
        "ticks": {
          "color": "#6B635B",
          "size": 18
        }
      },
      "encoding": {
        "y": {
          "field": "weight_mid",
          "type": "quantitative",
          "title": "Typical weight (kg)",
          "scale": {
            "zero": true,
            "domain": [
              0,
              10
            ]
          }
        },
        "color": {
          "field": "coat",
          "type": "nominal",
          "scale": {
            "domain": [
              "Short",
              "Long",
              "Short or long",
              "Rex or hairless"
            ],
            "range": [
              "#9A7B10",
              "#7E3F98",
              "#6E6E6E",
              "#3D2B56"
            ]
          },
          "legend": null
        },
        "opacity": {
          "value": 1
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 38,
        "fill": "#FFFFFF",
        "stroke": "#2B2622",
        "strokeWidth": 1,
        "opacity": 0.9
      },
      "encoding": {
        "y": {
          "field": "weight_mid",
          "type": "quantitative"
        },
        "xOffset": {
          "field": "jit",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "range": [
              {
                "expr": "width/8-24"
              },
              {
                "expr": "width/8+24"
              }
            ]
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Breed"
          },
          {
            "field": "weight_min",
            "title": "Min (kg)"
          },
          {
            "field": "weight_max",
            "title": "Max (kg)"
          }
        ],
        "x": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Short (32)",
            "Long (19)",
            "Short or long (9)",
            "Rex or hairless (7)"
          ]
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#2B2622",
        "dy": -12
      },
      "encoding": {
        "y": {
          "field": "weight_mid",
          "type": "quantitative"
        },
        "xOffset": {
          "field": "jit",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "range": [
              {
                "expr": "width/8-24"
              },
              {
                "expr": "width/8+24"
              }
            ]
          }
        },
        "x": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Short (32)",
            "Long (19)",
            "Short or long (9)",
            "Rex or hairless (7)"
          ]
        },
        "text": {
          "field": "name"
        }
      },
      "description": "Label for Maine Coon, one of the two heaviest breeds",
      "transform": [
        {
          "filter": "datum.name === 'Maine Coon'"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#2B2622",
        "dy": -12
      },
      "encoding": {
        "y": {
          "field": "weight_mid",
          "type": "quantitative"
        },
        "xOffset": {
          "field": "jit",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "range": [
              {
                "expr": "width/8-24"
              },
              {
                "expr": "width/8+24"
              }
            ]
          }
        },
        "x": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Short (32)",
            "Long (19)",
            "Short or long (9)",
            "Rex or hairless (7)"
          ]
        },
        "text": {
          "field": "name"
        }
      },
      "description": "Label for Chausie, one of the two heaviest breeds",
      "transform": [
        {
          "filter": "datum.name === 'Chausie'"
        }
      ]
    }
  ]
}