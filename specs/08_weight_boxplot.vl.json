{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Typical weight by coat group, 67 breeds",
  "data": {
    "url": "data/weight_by_coat.csv"
  },
  "width": "container",
  "height": 320,
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "n"
        }
      ],
      "groupby": [
        "coat"
      ]
    },
    {
      "calculate": "datum.coat + ' (' + datum.n + ')'",
      "as": "group"
    },
    {
      "calculate": "random()",
      "as": "jit"
    }
  ],
  "encoding": {
    "x": {
      "field": "group",
      "type": "nominal",
      "title": null,
      "sort": [
        "Short (32)",
        "Long (19)",
        "Short or long (9)",
        "Rex or hairless (7)"
      ],
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelLimit": 0,
        "labelColor": {
          "expr": "indexof(datum.label, 'Short or long') === 0 ? '#7A7A1F' : indexof(datum.label, 'Short') === 0 ? '#1B7A3E' : indexof(datum.label, 'Long') === 0 ? '#5C2A4A' : '#C2507A'"
        },
        "labelFontWeight": 700
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": "min-max",
        "size": 64,
        "median": {
          "color": "#FFFFFF",
          "size": 64,
          "thickness": 3
        },
        "rule": {
          "color": "#6B635B"
        },
        "ticks": {
          "color": "#6B635B",
          "size": 18
        }
      },
      "encoding": {
        "y": {
          "field": "weight_mid",
          "type": "quantitative",
          "title": "Typical weight (kg)",
          "scale": {
            "zero": true,
            "domain": [
              0,
              10
            ]
          }
        },
        "color": {
          "field": "coat",
          "type": "nominal",
          "scale": {
            "domain": [
              "Short",
              "Long",
              "Short or long",
              "Rex or hairless"
            ],
            "range": [
              "#1B7A3E",
              "#5C2A4A",
              "#7A7A1F",
              "#C2507A"
            ]
          },
          "legend": null
        },
        "opacity": {
          "value": 1
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 38,
        "fill": "#FFFFFF",
        "stroke": "#2B2622",
        "strokeWidth": 1,
        "opacity": 0.9
      },
      "encoding": {
        "y": {
          "field": "weight_mid",
          "type": "quantitative"
        },
        "xOffset": {
          "field": "jit",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "range": [
              {
                "expr": "width/8-24"
              },
              {
                "expr": "width/8+24"
              }
            ]
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Breed"
          },
          {
            "field": "weight_min",
            "title": "Min (kg)"
          },
          {
            "field": "weight_max",
            "title": "Max (kg)"
          }
        ],
        "x": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Short (32)",
            "Long (19)",
            "Short or long (9)",
            "Rex or hairless (7)"
          ]
        }
      }
    }
  ]
}