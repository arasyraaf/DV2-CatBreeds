{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Trait scores for the five most-searched breeds, with the average breed as a reference row",
  "data": {
    "url": "data/traits_favourites.csv"
  },
  "width": "container",
  "height": {
    "step": 46
  },
  "encoding": {
    "x": {
      "field": "trait",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "trait_order"
      },
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "labelFontSize": 12,
        "labelFontWeight": 700,
        "labelPadding": 24,
        "labelExpr": "split(replace(datum.label, '-', '- '), ' ')",
        "labelBaseline": "bottom",
        "labelLineHeight": 14
      }
    },
    "y": {
      "field": "name",
      "type": "nominal",
      "title": null,
      "sort": [
        "Ragdoll",
        "Maine Coon",
        "British Shorthair",
        "Bengal",
        "Persian",
        "Average of all 67 breeds"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 13,
        "labelPadding": 8,
        "labelFontWeight": {
          "expr": "datum.label === 'Average of all 67 breeds' ? 'normal' : 'bold'"
        }
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 3,
        "cornerRadius": 3
      },
      "encoding": {
        "color": {
          "field": "score",
          "type": "quantitative",
          "title": "Score (1 = low, 5 = high)",
          "scale": {
            "domain": [
              1,
              5
            ],
            "range": [
              "#ECEDF8",
              "#C3C7EA",
              "#8B92D3",
              "#5058AE",
              "#262C6E"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 200
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Breed"
          },
          {
            "field": "trait",
            "title": "Trait"
          },
          {
            "field": "score",
            "title": "Score (1 to 5)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "score",
          "type": "quantitative",
          "format": ".2~f"
        },
        "color": {
          "condition": {
            "test": "datum.score >= 3.5",
            "value": "#FFFFFF"
          },
          "value": "#2B2622"
        }
      }
    }
  ]
}